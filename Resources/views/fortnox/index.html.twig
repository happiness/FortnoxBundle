{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block main %}
    {% if error %}
        {{ widgets.callout('danger', error) }}
    {% endif %}

    {{ form_start(form) }}

    {% embed '@theme/embeds/card.html.twig' %}
        {% block box_title %}{{ 'fortnox.filters'|trans }}{% endblock %}
        {% block box_body %}
            <div class="row">
                <div class="col-md-6">{{ form_row(form.customer) }}</div>
                <div class="col-md-6">{{ form_row(form.project) }}</div>
                <div class="col-md-3">{{ form_row(form.begin) }}</div>
                <div class="col-md-3">{{ form_row(form.end) }}</div>
                <div class="col-md-3">{{ form_row(form.billableOnly) }}</div>
                <div class="col-md-3">{{ form_row(form.notExportedOnly) }}</div>
            </div>
            <button class="btn btn-primary" type="submit" name="preview" value="1">
                <i class="fas fa-search"></i> {{ 'fortnox.preview'|trans }}
            </button>
        {% endblock %}
    {% endembed %}

    {% if searched %}
        {% embed '@theme/embeds/card.html.twig' %}
            {% block box_title %}{{ 'fortnox.preview_title'|trans }}{% endblock %}
            {% block box_body_class %}p-0{% endblock %}
            {% block box_body %}
                {% if entries is empty %}
                    <div class="p-3">{{ 'fortnox.no_entries'|trans }}</div>
                {% else %}
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th>{{ 'date'|trans }}</th>
                            <th>{{ 'user'|trans }}</th>
                            <th>{{ 'activity'|trans }}</th>
                            <th>{{ 'description'|trans }}</th>
                            <th class="text-end">{{ 'duration'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entry in entries %}
                            <tr>
                                <td>{{ entry.begin|date_short }}</td>
                                <td>{{ entry.user.displayName }}</td>
                                <td>{{ entry.activity ? entry.activity.name : '' }}</td>
                                <td>{{ entry.description }}</td>
                                <td class="text-end">{{ entry.duration|duration }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                        <tfoot>
                        <tr>
                            <th colspan="4">{{ 'sum.total'|trans }}</th>
                            <th class="text-end">{{ totalDuration|duration }}</th>
                        </tr>
                        </tfoot>
                    </table>
                {% endif %}
            {% endblock %}
            {% block box_footer %}
                {% if entries is not empty %}
                    <button class="btn btn-success" type="submit" name="download" value="1">
                        <i class="fas fa-file-pdf"></i> {{ 'fortnox.download_pdf'|trans }}
                    </button>
                {% endif %}
            {% endblock %}
        {% endembed %}
    {% endif %}

    {{ form_end(form) }}
{% endblock %}
