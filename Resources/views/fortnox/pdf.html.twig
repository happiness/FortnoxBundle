<!doctype html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <title>Tidrapport</title>
    <style>
        body { font-family: sans-serif; font-size: 10pt; color: #222; }
        h1 { font-size: 18pt; margin: 0 0 12px 0; }
        table.entries { width: 100%; border-collapse: collapse; }
        .entries th { border-bottom: 1px solid #444; text-align: left; padding: 6px 4px; }
        .entries td { border-bottom: 1px solid #ddd; padding: 6px 4px; vertical-align: top; }
        .entries .duration { text-align: right; white-space: nowrap; }
        .total td { font-weight: bold; border-top: 2px solid #444; }
        .muted { color: #666; }
    </style>
</head>
<body>
<h1>Tidrapport</h1>

<table class="entries">
    <thead>
    <tr>
        <th>Datum</th>
        <th>Aktivitet</th>
        <th>Beskrivning</th>
        <th class="duration">Tid</th>
    </tr>
    </thead>
    <tbody>
    {% set total = 0 %}
    {% for entry in entries %}
        {% set total = total + entry.duration %}
        <tr>
            <td>{{ entry.begin|date('Y-m-d') }}</td>
            <td>{{ entry.activity ? entry.activity.name : '' }}</td>
            <td>{{ entry.description }}</td>
            <td class="duration">{{ entry.duration|duration }}</td>
        </tr>
    {% else %}
        <tr><td colspan="4" class="muted">Inga tidposter hittades.</td></tr>
    {% endfor %}
    <tr class="total">
        <td colspan="3">Totalt</td>
        <td class="duration">{{ total|duration }}</td>
    </tr>
    </tbody>
</table>
</body>
</html>
